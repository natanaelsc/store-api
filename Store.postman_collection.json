        {
          "name": "Criar Produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('productId', json.id);",
                  "    console.log('productId salvo:', json.id);",
                  "}",
                  "",
                  "pm.test('Status 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Produto tem ID', () => {",
                  "    pm.expect(pm.response.json().id).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Preço correto', () => {",
                  "    pm.expect(pm.response.json().price).to.eql(2999.99);",
