      "name": "Produtos",
      "item": [
        {
          "name": "Criar Produto - Preço Inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Erro de validação no preço', () => {",
                  "    const errors = pm.response.json();",
                  "    pm.expect(errors.some(e => e.propertyName === 'Price')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
